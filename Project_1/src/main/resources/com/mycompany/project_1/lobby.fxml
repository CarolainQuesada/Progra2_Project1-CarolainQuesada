<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="699.0" prefWidth="800.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.LobbyController">
    <stylesheets>
        <URL value="@/styles/lobby.css" />
    </stylesheets>
   <children>
      <ImageView fitHeight="717.0" fitWidth="800.0" layoutY="1.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../../../imagenes/info.png" />
         </image></ImageView>
      <RadioButton fx:id="rbHard" layoutX="29.0" layoutY="257.0" mnemonicParsing="false" prefHeight="30.0" prefWidth="106.0" selected="true" text="Difícil">
         <toggleGroup>
            <ToggleGroup fx:id="dificultad" />
         </toggleGroup>
         <font>
            <Font name="Bernard MT Condensed" size="17.0" />
         </font></RadioButton>
      <RadioButton fx:id="rbMedium" layoutX="30.0" layoutY="204.0" mnemonicParsing="false" prefHeight="30.0" prefWidth="105.0" selected="true" text="Intermedia" toggleGroup="$dificultad">
         <font>
            <Font name="Bernard MT Condensed" size="17.0" />
         </font></RadioButton>
      <RadioButton fx:id="rbEasy" layoutX="30.0" layoutY="154.0" mnemonicParsing="false" prefHeight="30.0" prefWidth="106.0" selected="true" text="Fácil" toggleGroup="$dificultad">
         <font>
            <Font name="Bernard MT Condensed" size="16.0" />
         </font></RadioButton>
      <Label layoutX="30.0" layoutY="62.0" prefHeight="30.0" prefWidth="190.0" style="-fx-background-color: B0C4DE;" text="Seleciona la dificultad ">
         <font>
            <Font name="Bernard MT Condensed" size="17.0" />
         </font></Label>
      <Label layoutX="336.0" layoutY="50.0" text="Ingresa su nombre:">
         <font>
            <Font name="Bernard MT Condensed" size="17.0" />
         </font></Label>
      <TextField fx:id="txtName" layoutX="515.0" layoutY="49.0" />
      <Button fx:id="btnPlay" layoutX="634.0" layoutY="596.0" mnemonicParsing="false" onAction="#changeToBoard" prefHeight="26.0" prefWidth="94.0" text="Jugar">
         <font>
            <Font name="Bernard MT Condensed" size="16.0" />
         </font></Button>
      <Button fx:id="btnBack" layoutX="30.0" layoutY="629.0" mnemonicParsing="false" onAction="#comeBackToPrimary" text="Regresar">
         <font>
            <Font name="Bernard MT Condensed" size="12.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
